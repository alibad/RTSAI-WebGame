<Project>
  <!--
    RTSAI-WebGame: the real OpenRA simulation (engine + RTS AI mod) compiled for the browser.
    EngineRoot is the rtsai/web-engine worktree; ModRoot is the RTSAI-Mod checkout whose C# and data we load.
    Both are read-only inputs: nothing here writes into them except the engine's own bin/ + obj/ build output.
  -->
  <PropertyGroup>
    <EngineRoot Condition="'$(EngineRoot)' == ''">$(MSBuildThisFileDirectory)..\OpenRA-wt-web\</EngineRoot>
    <!-- WebProfile "public": the standalone mod (rtsai/standalone, no EA content); default: the RA2 mod (private content). -->
    <ModRoot Condition="'$(ModRoot)' == '' And '$(WebProfile)' == 'public'">$(MSBuildThisFileDirectory)..\RTSAI-Mod-wt-web-public\</ModRoot>
    <ModRoot Condition="'$(ModRoot)' == ''">$(MSBuildThisFileDirectory)..\RTSAI-Mod\</ModRoot>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591;CA1416;IDE0005;NU1900</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <!-- AOT and interpreter browser builds relink different native runtimes, and profiles compile different mod
         sources: keep their intermediates apart. -->
    <VariantSuffix Condition="'$(WebProfile)' != ''">-$(WebProfile)</VariantSuffix>
    <VariantSuffix Condition="'$(Aot)' == 'true'">$(VariantSuffix)-aot</VariantSuffix>
    <!-- The public game's AOT runtime is the lean variant (OpenRA.WebSim.Browser.csproj): 12 MB instead of 17 MB. -->
    <RuntimeVariant Condition="'$(RuntimeVariant)' == '' And '$(WebProfile)' == 'public' And '$(Aot)' == 'true'">lean</RuntimeVariant>
    <VariantSuffix Condition="'$(RuntimeVariant)' != ''">$(VariantSuffix)-$(RuntimeVariant)</VariantSuffix>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(MSBuildProjectName)$(VariantSuffix)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)$(VariantSuffix)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
