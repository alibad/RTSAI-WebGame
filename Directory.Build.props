<Project>
  <!--
    RTSAI-WebGame: the real OpenRA simulation (engine + RTS AI mod) compiled for the browser.
    EngineRoot is a session-private no-Git copy of the verified pinned engine archive.
    ModRoot is a verified standalone main source snapshot. Never compile against a live sibling or shared input.
  -->
  <PropertyGroup>
    <EngineRoot Condition="'$(EngineRoot)' == ''">$(MSBuildThisFileDirectory).build-deps/engine/</EngineRoot>
    <!-- Main source snapshots already contain the standalone product; public requires its provenance checks. -->
    <ModRoot Condition="'$(ModRoot)' == ''">$(MSBuildThisFileDirectory).inputs/mod/</ModRoot>
    <WebBuildRoot Condition="'$(WebBuildRoot)' == ''">$(MSBuildThisFileDirectory)</WebBuildRoot>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591;CA1416;IDE0005;NU1900</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <!-- AOT and interpreter browser builds relink different native runtimes, and profiles compile different mod
         sources: keep their intermediates apart. -->
    <VariantSuffix Condition="'$(WebProfile)' != ''">-$(WebProfile)</VariantSuffix>
    <VariantSuffix Condition="'$(Aot)' == 'true'">$(VariantSuffix)-aot</VariantSuffix>
    <!-- Keep partial trimming and IL for the reflection-heavy public game. The aggressively stripped lean
         variant remains opt-in: its current runtime aborts during core-library AOT initialization. -->
    <RuntimeVariant Condition="'$(RuntimeVariant)' == '' And '$(WebProfile)' == 'public' And '$(Aot)' == 'true'">standard</RuntimeVariant>
    <VariantSuffix Condition="'$(RuntimeVariant)' != ''">$(VariantSuffix)-$(RuntimeVariant)</VariantSuffix>
    <BaseOutputPath>$(WebBuildRoot)bin/$(MSBuildProjectName)$(VariantSuffix)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(WebBuildRoot)obj/$(MSBuildProjectName)$(VariantSuffix)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
