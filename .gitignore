# Build output
bin/
obj/
node_modules/
web/dist/
build/
data/
artifacts/

# Bundles are generated from the mod checkout; never commit them.
*.pack

# EA content must never enter this repository (it lives in %LOCALAPPDATA%\RTSAI-WebGame\private).
*.mix
*.bag
*.idx
private/

# Verified no-Git dependency snapshots, never commit local inputs.
.inputs/
.build-deps/

# Local Python adapter bytecode.
/tools/__pycache__/

# Local env files (Firebase web config for the public build lives in web/.env.production.local).
.env*.local

# The website's Faction viewer data (tools/sync-viewer.mjs), generated.
web/public/viewer/
