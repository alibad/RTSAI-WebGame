<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    The OpenRA simulation for the browser (Mono WebAssembly runtime), driven from a Web Worker.
    Interpreter by default; -p:Aot=true compiles every assembly ahead of time (needs the wasm-tools workload).
    Build:  dotnet publish sim/OpenRA.WebSim.Browser -c Release [-p:Aot=true]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OpenRA.WebSim.Browser</AssemblyName>
    <RootNamespace>OpenRA.WebSim.Browser</RootNamespace>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <!-- OpenRA builds everything by reflection (ObjectCreator, FieldLoader, Sync): keep all IL. -->
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Real culture data (ICU, the small EFIGS shard): Fluent's plural rules are looked up by language and
         throw under invariant globalization, which showed bot names as their message key. The simulation itself
         parses and formats with the invariant culture, so this does not affect determinism (parity-checked). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <WasmIncludeFullIcuData>false</WasmIncludeFullIcuData>
    <WasmIcuDataFileName>icudt_EFIGS.dat</WasmIcuDataFileName>
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <EmccInitialHeapSize>268435456</EmccInitialHeapSize>
    <EmccMaximumHeapSize>4294901760</EmccMaximumHeapSize>
    <CompressionEnabled>false</CompressionEnabled>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Aot)' == 'true' Or '$(Trim)' == 'true'">
    <!-- AOT requires the trimmer. Partial mode only trims framework assemblies marked trimmable; OpenRA and
         mod assemblies (reflection-heavy) are rooted whole below. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Aot)' == 'true'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT>
  </PropertyGroup>
  <ItemGroup Condition="'$(Aot)' == 'true' Or '$(Trim)' == 'true'">
    <TrimmerRootAssembly Include="OpenRA.Game" />
    <TrimmerRootAssembly Include="OpenRA.Mods.Common" />
    <TrimmerRootAssembly Include="OpenRA.Mods.Cnc" />
    <TrimmerRootAssembly Include="OpenRA.Mods.RA2" />
    <TrimmerRootAssembly Include="OpenRA.Mods.RTSAI" />
    <TrimmerRootAssembly Include="OpenRA.WebSim" />
    <TrimmerRootAssembly Include="System.Collections.Immutable" />
    <TrimmerRootAssembly Include="System.Collections" />
    <TrimmerRootAssembly Include="System.Linq" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenRA.WebSim\OpenRA.WebSim.csproj" />
  </ItemGroup>
</Project>
